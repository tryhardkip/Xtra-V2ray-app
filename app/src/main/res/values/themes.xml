<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      AMOLED dark theme: based on the platform Material dark theme but with a
      pure-black window background so OLED/AMOLED pixels are fully off.
    -->
    <style name="AppTheme" parent="@android:style/Theme.Material">
        <item name="android:windowBackground">@color/amoled_black</item>
        <item name="android:colorBackground">@color/amoled_black</item>
        <item name="android:colorPrimary">@color/amoled_black</item>
        <item name="android:colorPrimaryDark">@color/amoled_black</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/amoled_black</item>
        <item name="android:navigationBarColor">@color/amoled_black</item>
    </style>
</resources>
